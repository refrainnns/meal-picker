  // 鲁菜
  { re:/鲁|山东|黄焖鸡|把子肉|葱烧|九转|糖醋鲤鱼|油焖|济南|青岛|鲁味|油旋|闫府|金春禧/, tags:['鲁菜'] },
  // 闽菜
  { re:/闽|福建|佛跳墙|荔枝肉|鱼丸|扁肉|肉燕|福州|厦门|泉州|聚春园|海蛎煎|芋泥|沙县/, tags:['闽菜'] },
  // 徽菜
  { re:/徽|安徽|小菜园|臭鳜|毛豆腐|胡适|绩溪|黄山|徽商|石鸡|石耳/, tags:['徽菜'] },
  // 苏菜/淮扬
  { re:/苏|淮扬|扬州|南京|狮子头|大煮干丝|盐水鸭|金陵|苏州|无锡|美龄粥|糖芋苗|鸭血粉丝|烤鸭.*南京|南京.*烤鸭/, tags:['苏菜/淮扬菜'] },
  // 浙菜/杭帮
  { re:/浙|杭帮|杭州|外婆家|绿茶餐厅|东坡|西湖|龙井|叫花|宋嫂|宁波|温州|知味观|片儿川|猫耳朵|茶香鸡|新白鹿/, tags:['浙菜/杭帮菜'] },

  // === 日韩料理 ===
  { re:/吉野家|食其家|味千|村上一屋|米村|釜山|日式|刺身|寿司|拉面|定食|味噌|照烧|天妇罗|鳗鱼|丼|韩式|拌饭|泡菜|大酱/, tags:['日韩料理'] },
  // 日料单独标签
  { re:/吉野家|食其家|味千|村上一屋|日式|刺身|寿司|拉面|定食|味噌|照烧|天妇罗|鳗鱼|丼/, tags:['日料'] },
  // 韩料单独标签
  { re:/米村|釜山|韩式|拌饭|泡菜|大酱|部队锅|参鸡汤/, tags:['韩料'] },

  // === 海鲜 ===
  { re:/海鲜|龙虾|螃蟹|蟹|虾滑|虾仁|扇贝|生蚝|蛤蜊|鱿鱼|鲍鱼|海参|鱼头|蒸鱼|烤鱼|酸菜鱼|水煮鱼|龙利鱼|巴沙鱼|鳕鱼|鲈鱼|鳗鱼|刺身|肉蟹煲|胖哥俩/, tags:['海鲜'] },

  // === 火锅/烧烤 ===
  { re:/火锅|海底捞|小龙坎|楠火锅|胡大|涮|毛肚|鸭肠|鹅肠|酥肉/, tags:['火锅'] },
  { re:/烧烤|木屋|羊肉串|烤串|丰茂|很久以前|烤羊|烤鸡翅|烤茄子/, tags:['烧烤'] },

  // === 其他菜系 ===
  { re:/西贝|西北|莜面/, tags:['西北菜'] },
  { re:/云海肴|汽锅|云南|过桥米线/, tags:['云南菜'] },
  { re:/螺蛳粉/, tags:['广西菜'] },
  { re:/潮汕|粿条|牛肉丸|猪杂汤/, tags:['潮汕菜'] },
  { re:/鼎泰丰|蔡澜|大家乐|港式|焗猪扒|港式点心|茶餐厅|丝袜奶茶|菠萝油/, tags:['港式/台式'] },
  { re:/桃园眷村|台式|台湾|卤肉饭|蚵仔煎|大肠包小肠/, tags:['台湾菜'] },
  { re:/小杨生煎|上海|南翔|生煎包/, tags:['上海小吃'] },
  { re:/煎饼|糖油饼|油条|豆浆.*油条|豆腐脑/, tags:['传统早点'] },

  // === 外卖常见品类标签 ===
  { re:/巴比|甘其食|包子铺|馒头|包子/, tags:['中式快餐','面点'] },
  { re:/老乡鸡|大米先生|乡村基|真功夫|永和大王|杨铭宇|焦耳|谷田/, tags:['中式快餐'] },
  { re:/沙县小吃/, tags:['中式快餐','闽菜'] },
  { re:/黄焖鸡/, tags:['中式快餐','鲁菜'] },
  { re:/粥|宏状元|嘉和一品|曼玲|员外/, tags:['粥店'] },
  { re:/麦当劳|肯德基|汉堡王|KFC|McDonald|必胜客|达美乐|Dunkin|赛百味|Subway/, tags:['西式快餐'] },
  { re:/全家|罗森|7-11|便利蜂|关东煮/, tags:['便利店'] },
  { re:/瑞幸|星巴克|Manner|Tims|奈雪|喜茶|味多美|巴黎贝甜|好利来|鲍师傅/, tags:['咖啡轻食'] },
  { re:/Wagas|沙绿|gaga|fitgreen|超能鹿战队/, tags:['轻食沙拉'] },
  { re:/麻辣烫|觅姐|杨国福|张亮|小蛮椒/, tags:['麻辣烫'] },
  { re:/蒸浏记|蒸功夫|浏阳蒸菜/, tags:['蒸菜'] },
  { re:/和府捞面|陈香贵|遇见小面|霸蛮|阿香|兰州|李先生|吉祥馄饨/, tags:['面馆/粉店'] },
  { re:/太二|鱼你在一起|姚姚酸菜鱼/, tags:['酸菜鱼','川菜','海鲜'] },
  { re:/炖汤|炖品|花旗参|茶树菇|炖罐/, tags:['炖品/汤品','粤菜'] },
  // 兜底
  { re:/.*/, tags:['其他'] },
];

function getMealCuisines(meal) {
  var txt = (meal.name || '') + '|' + (meal.platform || '');
  var found = [];
  for (var i = 0; i < CUISINE_RULES.length; i++) {
    if (CUISINE_RULES[i].re.test(txt)) {
      found = found.concat(CUISINE_RULES[i].tags);
    }
  }
  // 去重
  var seen = {};
  var result = [];
  for (var j = 0; j < found.length; j++) {
    if (!seen[found[j]]) { seen[found[j]] = true; result.push(found[j]); }
  }
  return result.length > 0 ? result : ['其他'];
}

function getMealCuisine(meal) {
  var tags = getMealCuisines(meal);
  return (tags && tags.length > 0) ? tags[0] : '其他';
}

function getMealPrice(meal) {
  var txt = (meal.name || '') + '|' + (meal.platform || '') + '|' + (meal.price || '');
  for (var i = 0; i < PRICE_RULES.length; i++) {
    if (PRICE_RULES[i].re.test(txt)) return PRICE_RULES[i].price;
  }
  return '¥25-40';
}

// ==================== 筛选状态 ====================
var selectedCuisines = [];
var selectedPrice = '';

var ALL_CUISINES = [
  '川菜','粤菜','湘菜','鲁菜','闽菜','徽菜','苏菜/淮扬菜','浙菜/杭帮菜',
  '日料','韩料','日韩料理','海鲜','火锅','烧烤',
  '中式快餐','面馆/粉店','粥店','蒸菜','麻辣烫','酸菜鱼',
  '轻食沙拉','西式快餐','便利店','咖啡轻食',
  '港式/台式','台湾菜','上海小吃','传统早点',
  '西北菜','云南菜','广西菜','潮汕菜','炖品/汤品','面点','其他'
];

var PRICE_RULES = [
  { re:/全家桶|九宫格|谭鸭血|姜虎东.*烧酒|大龙燚.*牛油|佛跳墙.*聚春园/, price:'¥120+' },
  { re:/豪华|全餐|大董|海底捞|小龙坎|楠火锅|鼎泰丰|麻六记|烤匠|姜虎东|大龙燚|胡大|胖哥俩/, price:'¥80-120' },
  { re:/火锅|烧烤|太二|西贝.*羊排|达美乐|必胜客|大家乐|村上一屋|云海肴|炳胜|徐记海鲜|七欣天|左庭右院|捞王/, price:'¥60-80' },
  { re:/Wagas|gaga|沙绿|星巴克|奈雪|喜茶|蔡澜|巴黎贝甜|Manner|Tims|西贝|小菜园|米村|本家|杨记兴|冶春/, price:'¥40-60' },
  { re:/麦当劳|肯德基|汉堡王|吉野家|食其家|和府|遇见小面|霸蛮|阿香|陈香贵|老乡鸡|大米先生|乡村基|真功夫|杨铭宇|釜山|焦耳|赛百味|瑞幸|桃园眷村|小杨生煎|谷田|永和|呷哺|丸龟|博多|大户屋|寿司郎|BBQ/, price:'¥25-40' },
  { re:/巴比|甘其食|沙县|粥|全家|罗森|7-11|便利蜂|吉祥馄饨|五谷磨房|蒸浏记|蒸功夫|潮汕|曼玲|宏状元|嘉和|员外|煎饼|糖油饼|关东煮|冒菜|点都德.*虾饺/, price:'¥15-25' },
];

// ==================== 筛选状态 ====================
var ALL_PRICES = ['¥15-25', '¥25-40', '¥40-60', '¥60-80', '¥80-120', '¥120+'];

function buildFilterUI() {
  var cs = document.getElementById('cuisineSelect');
  cs.innerHTML = '<option value="">🔍 全部口味</option>';
  for (var i = 0; i < ALL_CUISINES.length; i++) {
    var c = ALL_CUISINES[i];
    var sel = selectedCuisines.indexOf(c) >= 0 ? ' selected' : '';
    cs.innerHTML += '<option value="' + c + '"' + sel + '>' + c + '</option>';
  }
  
  var ps = document.getElementById('priceSelect');
  ps.innerHTML = '<option value="">💰 全部预算</option>';
  for (var j = 0; j < ALL_PRICES.length; j++) {
    var p = ALL_PRICES[j];
    var sel2 = selectedPrice === p ? ' selected' : '';
    ps.innerHTML += '<option value="' + p + '"' + sel2 + '>' + p + '</option>';
  }
}

function onCuisineChange() {
  var v = document.getElementById('cuisineSelect').value;
  selectedCuisines = v ? [v] : [];
  buildFilterUI();
}

function onPriceChange() {
  selectedPrice = document.getElementById('priceSelect').value;
  buildFilterUI();
}

function resetFilters() {
  selectedCuisines = [];
  selectedPrice = '';
  buildFilterUI();
}

// 筛选菜品池（支持多标签）
function getFilteredPool() {
  var pool;
  if (isCheat) {
    pool = MEALS_DB[currentTab].cheat;
  } else {
    pool = MEALS_DB[currentTab].healthy;
  }
  
  // 菜系筛选（多标签：菜品匹配任一选中标签即可）
  if (selectedCuisines.length > 0) {
    pool = pool.filter(function(m) {
      var tags = getMealCuisines(m);
      for (var i = 0; i < selectedCuisines.length; i++) {
        if (tags.indexOf(selectedCuisines[i]) >= 0) return true;
      }
      return false;
    });
  }
  
  // 价格筛选
  if (selectedPrice) {
    pool = pool.filter(function(m) {
      return getMealPrice(m) === selectedPrice;
    });
  }
  
  return pool;
}

// ==================== 数据引用（来自 meals-data.js） ====================
// MEALS_DB 在 meals-data.js 中定义

// ==================== 状态 ====================
var currentTab = 'breakfast';
var eatMode = 'delivery';
var isHealthy = true;
var isCheat = false;
var mealHistory = [];
var isRolling = false;
var userLat = null;
var userLng = null;
var userAddr = '';

// ==================== 在家做菜谱数据 ====================
var RECIPES = {
breakfast:[
