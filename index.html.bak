// ==================== 吃饭方式切换 ====================
function switchMode(mode) {
  eatMode = mode;
  document.querySelectorAll('.mode-btn').forEach(function(b) {
    b.classList.toggle('active', b.dataset.mode === mode);
  });
  
  // 根据模式调整UI
  var filterSection = document.querySelector('.filter-section');
  var rollBtn = document.getElementById('rollBtn');
  var labels = { home: '🏠 在家做饭', delivery: '🛵 点外卖', dinein: '🍽️ 出去吃' };
  
  if (mode === 'home') {
    filterSection.style.display = 'none';
    rollBtn.textContent = '🎲 随机帮我选菜谱';
  } else if (mode === 'delivery') {
    filterSection.style.display = 'flex';
    rollBtn.textContent = '🎲 随机帮我选外卖';
    // 恢复外卖平台按钮
    document.getElementById('linkMt').style.display = '';
    document.getElementById('linkEle').style.display = '';
  } else {
    filterSection.style.display = 'flex';
    rollBtn.textContent = '🎲 随机帮我选餐厅';
  }
  
  updateMealTypeLabel();
  renderMeal(null);
  if (userLat) showNearby();
}

function updateMealTypeLabel() {
  var labels = {
    breakfast: { home: '🥣 早餐菜谱', delivery: '🥣 早餐外卖', dinein: '🥣 早餐餐厅' },
    lunch: { home: '🍱 午餐菜谱', delivery: '🍱 午餐外卖', dinein: '🍱 午餐餐厅' },
    dinner: { home: '🥢 晚餐菜谱', delivery: '🥢 晚餐外卖', dinein: '🥢 晚餐餐厅' }
  };
  document.getElementById('mealTypeLabel').textContent = labels[currentTab][eatMode];
}

// ==================== 初始化 ====================
function init() {
  updateClock();
  setInterval(updateClock, 60000);
  autoDetectMeal();
  buildFilterUI();
  updateMealTypeLabel();
  renderMeal(null);
  autoRequestLocation();
}

function updateClock() {
  var now = new Date();
  document.getElementById('clock').textContent =
    String(now.getHours()).padStart(2,'0') + ':' + String(now.getMinutes()).padStart(2,'0');
  autoDetectMeal();
}

function autoDetectMeal() {
  var h = new Date().getHours();
  var m = new Date().getMinutes();
  var t = h + m/60;
  var tagClass, label;
  if (t >= 4 && t < 10.5) { tagClass = 'morning'; label = '早餐时间'; }
  else if (t >= 10.5 && t < 15) { tagClass = 'noon'; label = '午餐时间'; }
  else { tagClass = 'night'; label = '晚餐时间'; }
  var tag = document.getElementById('mealTag');
  tag.textContent = label;
  tag.className = 'tag ' + tagClass;
}

// ==================== 定位（改进版） ====================
function autoRequestLocation() {
  // 优先尝试 IP 定位（无权限要求，快速）
  useIPLocation(true);
}

function showLocOptions(e) {
  document.getElementById('locOverlay').style.display = 'flex';
  document.getElementById('locStatus').textContent = '';
  document.getElementById('cityInput').value = userAddr || '';
}

function closeLocOptions(e) {
  if (e && e.target !== document.getElementById('locOverlay')) return;
  document.getElementById('locOverlay').style.display = 'none';
}

function setManualLocation() {
  var city = document.getElementById('cityInput').value.trim();
  if (!city) {
    document.getElementById('locStatus').textContent = '请输入城市名';
    return;
  }
  userAddr = city;
  userLat = null; userLng = null;
  document.getElementById('locAddr').textContent = '📍 ' + city;
  document.getElementById('locOverlay').style.display = 'none';
  document.getElementById('locStatus').textContent = '';
  // 用城市名获取坐标
  geocodeCity(city);
}

// 城市名→坐标（免费 Nominatim 搜索 API）
function geocodeCity(city) {
  var xhr = new XMLHttpRequest();
  xhr.open('GET', 'https://nominatim.openstreetmap.org/search?format=json&q=' + encodeURIComponent(city) + '&limit=1&accept-language=zh', true);
  xhr.timeout = 8000;
  xhr.onload = function() {
    if (xhr.status === 200) {
      try {
        var data = JSON.parse(xhr.responseText);
        if (data && data.length > 0) {
          userLat = parseFloat(data[0].lat);
          userLng = parseFloat(data[0].lon);
          document.getElementById('locAddr').textContent = '📍 ' + (data[0].display_name || city);
          showNearby();
          return;
        }
      } catch(e) {}
    }
    // 失败也显示附近（用默认坐标）
    document.getElementById('locAddr').textContent = '📍 ' + city;
    showNearby();
  };
  xhr.onerror = function() {
    document.getElementById('locAddr').textContent = '📍 ' + city;
    showNearby();
  };
  xhr.ontimeout = function() {
    document.getElementById('locAddr').textContent = '📍 ' + city;
    showNearby();
  };
  xhr.send();
}

// GPS 精确定位
function requestLocation() {
  var statusEl = document.getElementById('locStatus');
  statusEl.textContent = '正在获取GPS位置...';
  
  if (!navigator.geolocation) {
    statusEl.textContent = '⚠️ 浏览器不支持GPS定位，请手动输入城市';
    return;
  }
  
  navigator.geolocation.getCurrentPosition(
    function(pos) {
      userLat = pos.coords.latitude;
      userLng = pos.coords.longitude;
      statusEl.textContent = '✅ GPS定位成功，正在获取地址...';
      reverseGeocode(userLat, userLng, function() {
        document.getElementById('locOverlay').style.display = 'none';
        showNearby();
      });
    },
    function(err) {
      var msg = 'GPS定位失败';
      if (err.code === 1) msg = '⚠️ 请允许定位权限后重试';
      else if (err.code === 2) msg = '⚠️ 无法获取位置信号';
      else if (err.code === 3) msg = '⚠️ 定位超时，请手动输入城市';
      statusEl.textContent = msg;
    },
    { enableHighAccuracy: true, timeout: 12000, maximumAge: 300000 }
  );
}

// IP 模糊定位（无需权限）
function useIPLocation(silent) {
  var statusEl = document.getElementById('locStatus');
  if (!silent) statusEl.textContent = '正在通过IP获取大致位置...';
  
  // Try ipapi.co first (may have CORS issues on HTTPS)
  tryIPService('https://ipapi.co/json/', silent, statusEl, function() {
    // Fallback to ipinfo.io
    tryIPService('https://ipinfo.io/json?token=', silent, statusEl, function() {
      if (!silent) statusEl.textContent = '⚠️ 自动定位失败，请手动输入城市';
    });
  });
}

function tryIPService(url, silent, statusEl, fallback) {
  var xhr = new XMLHttpRequest();
  xhr.open('GET', url, true);
  xhr.timeout = 5000;
  xhr.onload = function() {
    if (xhr.status === 200) {
      try {
        var data = JSON.parse(xhr.responseText);
        var city = data.city;
        var region = data.region || data.country;
        if (city) {
          userLat = data.latitude || data.loc ? parseFloat((data.loc||'').split(',')[0]) : null;
          userLng = data.longitude || data.loc ? parseFloat((data.loc||'').split(',')[1]) : null;
          userAddr = city + (region ? ' ' + region : '');
          document.getElementById('locAddr').textContent = '📍 ' + userAddr + '（IP定位）';
          if (!silent) {
            statusEl.textContent = '✅ 已定位到 ' + userAddr;
            setTimeout(function() { document.getElementById('locOverlay').style.display = 'none'; }, 800);
          }
          showNearby();
          return;
        }
      } catch(e) {}
    }
    fallback();
  };
  xhr.onerror = fallback;
  xhr.ontimeout = fallback;
  xhr.send();
}

// 逆地理编码（坐标→地址）
function reverseGeocode(lat, lng, callback) {
  var xhr = new XMLHttpRequest();
  xhr.open('GET', 'https://nominatim.openstreetmap.org/reverse?format=json&lat='+lat+'&lon='+lng+'&zoom=18&addressdetails=1&accept-language=zh', true);
  xhr.timeout = 6000;
  xhr.onload = function() {
    if (xhr.status === 200) {
      try {
        var data = JSON.parse(xhr.responseText);
        var addr = data.address;
        if (addr) {
          var parts = [];
          if (addr.city || addr.town || addr.county) parts.push(addr.city || addr.town || addr.county);
          if (addr.road || addr.suburb || addr.neighbourhood) parts.push(addr.road || addr.suburb || addr.neighbourhood);
          userAddr = parts.join(' ') || data.display_name || '';
          document.getElementById('locAddr').textContent = '📍 ' + (userAddr || '已获取位置');
        }
      } catch(e) {}
    }
    if (callback) callback();
  };
  xhr.onerror = function() {
    document.getElementById('locAddr').textContent = '📍 已定位 ('+lat.toFixed(3)+','+lng.toFixed(3)+')';
    if (callback) callback();
  };
  xhr.ontimeout = function() {
    document.getElementById('locAddr').textContent = '📍 已定位 ('+lat.toFixed(3)+','+lng.toFixed(3)+')';
    if (callback) callback();
  };
  xhr.send();
}

// ==================== 附近餐厅推荐 ====================
function showNearby() {
  if (!userLat || !userLng) return;
  
  var section = document.getElementById('nearbySection');
  section.style.display = 'block';
  
  var nearbyRestaurants = getMockNearby(currentTab, isCheat);
  
  document.getElementById('nearbyCount').textContent = ' · ' + nearbyRestaurants.length + '家推荐';
  document.getElementById('nearbyList').innerHTML = nearbyRestaurants.map(function(r) {
    return '<div class="nearby-card" onclick="openNearbyLink(\'' + r.keyword + '\')">' +
      '<div class="nc-name">' + r.name + '</div>' +
      '<div class="nc-type">' + r.type + '</div>' +
      '<div class="nc-rating">⭐ ' + r.rating + ' · ' + r.dist + '</div>' +
      '<div class="nc-link">🛵 去搜索 →</div>' +
    '</div>';
  }).join('');
  
  updatePlatformLinks();
}

function getMockNearby(mealType, cheat) {
  // 实际项目可接入美团/高德POI搜索API，这里返回推荐数据
  // 链接会真正打开对应平台的搜索
  var all = {
    breakfast: [
      { name:'巴比馒头', type:'包子·粥·豆浆', rating:'4.6', dist:'约800m', keyword:'巴比馒头 早餐' },
      { name:'永和大王', type:'豆浆·油条·饭团', rating:'4.4', dist:'约1.2km', keyword:'永和大王 早餐' },
      { name:'麦当劳', type:'汉堡·咖啡·早餐', rating:'4.5', dist:'约900m', keyword:'麦当劳 早餐' },
      { name:'三米粥铺', type:'粥·小菜·点心', rating:'4.7', dist:'约1.5km', keyword:'三米粥铺' },
      { name:'全家便利店', type:'饭团·三明治·关东煮', rating:'4.3', dist:'约400m', keyword:'全家 早餐' },
    ],
    lunch: [
      { name:'老乡鸡', type:'中式快餐·套餐', rating:'4.5', dist:'约600m', keyword:'老乡鸡' },
      { name:'大米先生', type:'现炒快餐·小碗菜', rating:'4.6', dist:'约800m', keyword:'大米先生' },
      { name:'杨国福麻辣烫', type:'麻辣烫·自选', rating:'4.3', dist:'约1.0km', keyword:'杨国福麻辣烫' },
      { name:'沙县小吃', type:'鸡腿饭·蒸饺·炖汤', rating:'4.2', dist:'约500m', keyword:'沙县小吃 鸡腿饭' },
      { name:'Wagas沃歌斯', type:'轻食·沙拉·果汁', rating:'4.6', dist:'约1.8km', keyword:'Wagas 沙拉' },
      { name:'吉野家', type:'日式牛肉饭·定食', rating:'4.4', dist:'约1.1km', keyword:'吉野家 定食' },
      { name:'太二酸菜鱼', type:'酸菜鱼·川菜', rating:'4.7', dist:'约2.2km', keyword:'太二酸菜鱼' },
    ],
    dinner: [
      { name:'三米粥铺', type:'养生粥·蒸饺·小菜', rating:'4.7', dist:'约1.5km', keyword:'三米粥铺' },
      { name:'蒸浏记', type:'浏阳蒸菜·原味', rating:'4.5', dist:'约1.3km', keyword:'蒸浏记 蒸菜' },
      { name:'全家便利店', type:'关东煮·沙拉·饭团', rating:'4.3', dist:'约400m', keyword:'全家 关东煮' },
      { name:'沙绿轻食', type:'沙拉碗·藜麦·低卡', rating:'4.6', dist:'约2.0km', keyword:'沙绿 沙拉' },
      { name:'海底捞外送', type:'火锅·冒菜', rating:'4.8', dist:'约3.0km', keyword:'海底捞 外送' },
    ]
  };
  
  var pool = all[mealType] || all.lunch;
  if (cheat && mealType === 'dinner') {
    pool = pool.concat([{ name:'木屋烧烤', type:'烧烤·烤串·啤酒', rating:'4.5', dist:'约1.8km', keyword:'木屋烧烤' }]);
  }
  
  // 打乱
  var shuffled = pool.slice().sort(function() { return Math.random() - 0.5; });
  return shuffled.slice(0, 5);
}

function openNearbyLink(keyword) {
  if (userLat && userLng) {
    var url = 'https://uri.amap.com/search?keyword=' + encodeURIComponent(keyword) + '&lon=' + userLng + '&lat=' + userLat + '&src=mealpicker';
    window.open(url, '_blank');
  } else {
    var url = 'https://waimai.meituan.com/ui/SearchResult/index?keyword=' + encodeURIComponent(keyword);
    window.open(url, '_blank');
  }
}

// ==================== 切换 Tab ====================
function switchTab(tab) {
  currentTab = tab;
  var buttons = document.querySelectorAll('.tab-btn');
  for (var i = 0; i < buttons.length; i++) {
    buttons[i].classList.remove('active','t-bf','t-lu','t-di');
    if (buttons[i].dataset.meal === tab) {
      buttons[i].classList.add('active');
      buttons[i].classList.add(tab === 'breakfast' ? 't-bf' : tab === 'lunch' ? 't-lu' : 't-di');
    }
  }
  var labels = { breakfast:'🥣 早餐外卖推荐', lunch:'🍱 午餐外卖推荐', dinner:'🥢 晚餐外卖推荐' };
  document.getElementById('mealTypeLabel').textContent = labels[tab];
  updateMealTypeLabel();
  renderMeal(null);
  if (userLat) showNearby();
}

function toggleHealth() {
  isHealthy = !isHealthy;
  document.getElementById('healthToggle').classList.toggle('on', isHealthy);
  if (isHealthy) {
    isCheat = false;
    document.getElementById('cheatToggle').classList.remove('on');
  }
  renderMeal(null);
}

function toggleCheat() {
  isCheat = !isCheat;
  document.getElementById('cheatToggle').classList.toggle('on', isCheat);
  if (isCheat) {
    isHealthy = false;
    document.getElementById('healthToggle').classList.remove('on');
  }
  renderMeal(null);
}

// ==================== 渲染餐食（支持三种模式） ====================
function renderMeal(meal) {
  var card = document.getElementById('mealCard');
  var badges = document.getElementById('platformBadges');
  var tip = document.getElementById('mealTip');
  
  if (!meal) {
    var tips = { home: '点击按钮获取菜谱灵感 ✨', delivery: '点击按钮随机推荐外卖 🛵', dinein: '点击按钮探索美味餐厅 🍽️' };
    document.getElementById('mealName').textContent = tips[eatMode] || '点击下方按钮开始';
    document.getElementById('mealCal').textContent = '~ kcal';
    document.getElementById('mealDetail').innerHTML = '';
    badges.style.display = 'none';
    tip.style.display = 'none';
    document.getElementById('knowledgeText').textContent = '《中国居民膳食指南（2022）》建议：每天摄入12种以上食物，每周25种以上。食物多样是平衡膳食的基础。';
    document.getElementById('knowledgeSource').textContent = '——中国营养学会';
    return;
  }
  
  document.getElementById('mealName').textContent = meal.name;
  document.getElementById('mealCal').textContent = meal.cal || '';
  
  if (eatMode === 'home') {
    // 在家做菜谱
    badges.style.display = 'none';
    tip.style.display = 'none';
    var html = '<div style="display:flex;gap:6px;margin:6px 0;flex-wrap:wrap;">' +
      '<span style="font-size:10px;background:#fff0e8;color:#ff6b35;padding:2px 8px;border-radius:8px;font-weight:600;">难度：'+(meal.diff||'简单')+'</span>' +
      '<span style="font-size:10px;background:#e8f5e9;color:#4caf84;padding:2px 8px;border-radius:8px;font-weight:600;">用时：'+(meal.time||'15分钟')+'</span>' +
      '</div>' +
      '<div style="font-size:12px;color:#666;margin:4px 0;"><strong>🛒 食材：</strong>'+(meal.ingredients||'')+'</div>' +
      '<div class="recipe-section"><div class="r-title">📝 步骤</div><div class="r-steps">';
    if (meal.steps) for (var s=0;s<meal.steps.length;s++) html += '<span>'+(s+1)+'. '+meal.steps[s]+'</span>';
    html += '</div></div>';
    document.getElementById('mealDetail').innerHTML = html;
    document.getElementById('knowledgeText').textContent = '💡 ' + (meal.tip || '自己做饭控制油盐，比外卖健康30%以上。');
    document.getElementById('knowledgeSource').textContent = '——家庭烹饪健康指南';
  } else if (eatMode === 'dinein') {
    // 出去吃餐厅
    badges.style.display = 'flex';
    document.getElementById('linkMt').style.display = 'none';
    document.getElementById('linkEle').style.display = 'none';
    var dineHtml = '<div style="display:flex;gap:6px;margin:6px 0;flex-wrap:wrap;">' +
      '<span style="font-size:10px;background:#fff0e8;color:#ff6b35;padding:2px 8px;border-radius:8px;font-weight:600;">'+(meal.type||'')+'</span>' +
      '<span style="font-size:10px;background:#e8f5e9;color:#4caf84;padding:2px 8px;border-radius:8px;font-weight:600;">人均：'+(meal.price||'')+'</span>' +
      '</div>' +
      '<div style="font-size:13px;color:#555;margin:4px 0;"><strong>🍽️ 推荐菜：</strong>'+(meal.dish||'')+'</div>' +
      '<div style="font-size:12px;color:#888;margin:4px 0;"><strong>📍 氛围：</strong>'+(meal.vibe||'')+'</div>';
    document.getElementById('mealDetail').innerHTML = dineHtml;
    tip.style.display = 'flex';
    document.getElementById('tipText').textContent = '推荐理由：' + (meal.why || '值得一试');
    document.getElementById('knowledgeText').textContent = meal.why || '';
    document.getElementById('knowledgeSource').textContent = '——到店用餐推荐';
    updatePlatformLinks(meal.name);
  } else {
    // 点外卖：原有展示逻辑
    var cuisine = (meal._cuisine && meal._cuisine !== 'undefined') ? meal._cuisine : (getMealCuisine(meal) || '其他');
    var price = meal._price || getMealPrice(meal) || '¥25-40';
    var tagHtml = '<div style="display:flex;gap:6px;margin-top:6px;">' +
      '<span style="font-size:10px;background:#fff0e8;color:#ff6b35;padding:2px 8px;border-radius:8px;font-weight:600;">' + cuisine + '</span>' +
      '<span style="font-size:10px;background:#e8f5e9;color:#4caf84;padding:2px 8px;border-radius:8px;font-weight:600;">' + price + '</span>' +
      '</div>';
    var m = meal.macros;
    document.getElementById('mealDetail').innerHTML = tagHtml +
      '<div class="row"><span class="dot dot-carb"></span> <strong>碳水：</strong>' + m.carb + '</div>' +
      '<div class="row"><span class="dot dot-protein"></span> <strong>蛋白质：</strong>' + m.protein + '</div>' +
      '<div class="row"><span class="dot dot-fat"></span> <strong>脂肪：</strong>' + m.fat + '</div>' +
      '<div class="row"><span class="dot dot-fiber"></span> <strong>纤维/蔬菜：</strong>' + m.fiber + '</div>' +
      '<div class="row"><span class="dot dot-tip"></span> <strong>外卖平台：</strong>' + (meal.platform || '多平台有售') + '</div>';
    if (m.tip) {
      tip.style.display = 'flex';
      document.getElementById('tipText').textContent = '点餐技巧：' + m.tip;
    } else { tip.style.display = 'none'; }
    badges.style.display = 'flex';
    updatePlatformLinks(meal.name);
    document.getElementById('knowledgeText').textContent = meal.knowledge;
    document.getElementById('knowledgeSource').textContent = meal.source;
  }
  
  card.classList.add('fade-in');
  setTimeout(function() { card.classList.remove('fade-in'); }, 500);
}

function updatePlatformLinks(mealName) {
  var keyword = mealName ? mealName.split('·')[0].trim().split(' ')[0] : '';
  
  if (mealName) {
    document.getElementById('linkMt').href = 
      'https://waimai.meituan.com/ui/SearchResult/index?keyword=' + encodeURIComponent(keyword);
    document.getElementById('linkEle').href = 
      'https://h5.ele.me/search/#keyword=' + encodeURIComponent(keyword);
    var mapLink = document.getElementById('linkMap');
    if (userLat) {
      mapLink.href = 'https://uri.amap.com/search?keyword=' + encodeURIComponent(keyword + ' 餐厅') + '&lon=' + userLng + '&lat=' + userLat + '&src=mealpicker';
      mapLink.onclick = null;
    } else {
      mapLink.href = '#';
      mapLink.onclick = function(e) { e.preventDefault(); requestLocation(); };
    }
  }
}

// ==================== 随机选择（支持三种模式） ====================
function rollMeal() {
  if (isRolling) return;
  
  var pool;
  if (eatMode === 'home') {
    pool = RECIPES[currentTab];
  } else if (eatMode === 'dinein') {
    pool = DINEIN_SPOTS[currentTab];
    if (selectedCuisines.length > 0) {
      pool = pool.filter(function(r) {
        for (var i=0;i<selectedCuisines.length;i++) {
          if ((r.type||'').indexOf(selectedCuisines[i])>=0) return true;
        }
        return false;
      });
    }
    if (selectedPrice) {
      pool = pool.filter(function(r) { return r.price === selectedPrice; });
    }
  } else {
    pool = getFilteredPool();
  }
  
  if (!pool || pool.length === 0) {
    alert('没有匹配当前筛选条件的选项，请放宽筛选条件');
    return;
  }
  
  isRolling = true;
  var btn = document.getElementById('rollBtn');
  var card = document.getElementById('mealCard');
  btn.classList.add('rolling');
  btn.textContent = '🔄 正在帮你挑...';
  card.classList.add('rolling');
  
  var count = 0;
  var maxTicks = 14;
  var interval = setInterval(function() {
    var rnd = pool[Math.floor(Math.random() * pool.length)];
    renderMealQuick(rnd);
    count++;
    if (count >= maxTicks) {
      clearInterval(interval);
      var final = pool[Math.floor(Math.random() * pool.length)];
      if (eatMode === 'delivery') {
        final._cuisine = getMealCuisine(final);
        final._price = getMealPrice(final);
      }
      renderMeal(final);
      addHistory(final);
      btn.classList.remove('rolling');
      btn.textContent = '🎲 再选一次';
      card.classList.remove('rolling');
      isRolling = false;
    }
  }, 70);
}

function renderMealQuick(meal) {
  document.getElementById('mealName').textContent = meal.name;
  document.getElementById('mealCal').textContent = meal.cal;
}

// ==================== 历史记录 ====================
function addHistory(meal) {
  var time = new Date().toLocaleTimeString('zh-CN', {hour:'2-digit',minute:'2-digit'});
  mealHistory.unshift({ name: meal.name, time: time, tab: currentTab, cheat: isCheat });
  if (mealHistory.length > 8) mealHistory.pop();
  renderHistory();
}

function renderHistory() {
  var sec = document.getElementById('historySection');
  var list = document.getElementById('historyList');
  if (mealHistory.length === 0) { sec.style.display = 'none'; return; }
  sec.style.display = 'block';
  var icons = { breakfast:'🌅', lunch:'☀️', dinner:'🌙' };
  list.innerHTML = mealHistory.map(function(h) {
    var shortName = h.name.length > 16 ? h.name.slice(0,15) + '…' : h.name;
    return '<span class="h-item">' + (icons[h.tab]||'') + ' ' + h.time + ' ' + (h.cheat?'🎉':'') + ' ' + shortName + '</span>';
  }).join('');
}

// ==================== 启动 ====================
init();
</script>
</body>
</html>
