M("点都德·白粥+叉烧包+白灼菜心+蒸凤爪","~400 kcal","点都德","白粥+包子约45g碳水","叉烧+凤爪约18g","凤爪含胶原蛋白","菜心","晚茶选蒸点+白粥养胃","粤式晚茶选择蒸点而非煎炸配白粥养胃。凤爪胶原蛋白丰富。","粤式晚茶"),
M("南京大牌档·鸭血粉丝汤+素烧鹅+小碗米饭","~380 kcal","南京大牌档","粉丝+米饭约45g碳水","鸭血+鸭胗约18g","鸭汤少量油脂","素烧鹅+香菜","鸭血粉丝汤是南京灵魂小吃","鸭血含血红素铁高吸收率素烧鹅是豆制品低脂高蛋白。","苏菜·南京"),
M("知味观·西湖莼菜汤+龙井虾仁+小米粥","~350 kcal","知味观/杭帮菜","小米粥约35g碳水","虾仁约20g","极少","莼菜+茶叶","知味观是杭州百年老字号","西湖莼菜汤滑嫩含胶质。龙井虾仁茶香虾鲜。浙式晚餐精致清淡。","杭帮菜"),
M("Wagas·泰式大虾沙拉+柠檬草茶","~320 kcal","Wagas","少量藜麦约20g碳水","大虾约22g","鱼露+青柠汁少油","生菜+薄荷+青木瓜","泰式沙拉酸辣清爽","泰式大虾沙拉用鱼露和青柠汁调味酸辣清爽无油。大虾高蛋白。","轻食·东南亚"),
M("木屋烧烤·烤生蚝×3+烤茄子+青椒+玉米","~350 kcal","木屋烧烤","玉米+茄子约35g碳水","生蚝约16g+高锌","烤制少量油","茄子+青椒+洋葱","烧烤全素+海鲜组合最健康","烤生蚝高锌高蛋白烤全素纤维丰富。烧烤中最健康组合。","烧烤·健康版"),
M("莆田餐厅·百秒黄花鱼+兴化米粉(小)+扁肉汤","~420 kcal","莆田餐厅","米粉约40g碳水","黄花鱼+扁肉约24g","蒸制少油","配菜","莆田是米其林星级闽菜","百秒黄花鱼100秒蒸制鱼肉嫩滑。兴化米粉细如发丝。闽式清淡晚餐。","闽菜·莆田"),
];
D.dinner.healthy=D.dinner.healthy.concat(dh);

var dc=[
M("🎉大龙燚·番茄鸳鸯锅+虾滑+毛肚+红糖冰粉","~900 kcal","大龙燚","冰粉+土豆约45g碳水","虾滑+毛肚约30g","牛油锅底高脂","蔬菜","鸳鸯锅满足不同口味","大龙燚鸳鸯锅一半麻辣一半番茄朋友聚餐各取所需。虾滑毛肚是必点。","成都火锅"),
M("🎉姜虎东·烤牛舌+调味牛排+海鲜饼+烧酒","~980 kcal","姜虎东白丁","海鲜饼约50g碳水","牛舌+牛排约35g","烤肉高脂","生菜+泡菜","牛舌是韩式烤肉的高级货","韩式烤牛舌薄切烤3秒即食脆嫩多汁。配海鲜饼和烧酒韩剧同款。","韩式烤肉"),
M("🎉谭鸭血·鸭血锅底+卤肥肠+贡菜+冰汤圆","~950 kcal","谭鸭血火锅","冰汤圆+贡菜约45g碳水","鸭血+肥肠+毛肚约35g","鸭血锅底高脂","贡菜","谭鸭血以鸭血锅底闻名","谭鸭血锅底自带鸭血鹌鹑蛋和卤豆腐。卤肥肠软糯入味。","成都火锅"),
M("🎉甬府·宁式十八斩+黄鱼面+汤圆","~880 kcal","甬府/米其林宁波菜","面条+汤圆约55g碳水","黄鱼+蟹约28g","烹调用油","配菜","甬府是米其林宁波菜放纵版","甬府宁式十八斩呛蟹鲜甜。黄鱼面东海大黄鱼汤浓。宁波汤圆收尾。","宁波菜·甬府"),
];
D.dinner.cheat=D.dinner.cheat.concat(dc);

})();

</script>
<script>
// ==================== 菜系与价格智能匹配（多标签版） ====================
// 每道菜可匹配多个菜系标签，确保筛选时都能找到

var CUISINE_RULES = [
  // === 八大菜系 ===
